# Safe default for machines without PostgreSQL local
TESTE=false
# Safe default for machines without IA integration
BlockedIA=true

# Optional explicit override
# If set, DB_ENABLED wins over TESTE
#DB_ENABLED=true

# Local Postgres (enable when the database is available)
#DB_URL=jdbc:postgresql://localhost:5432/simulatorbolsastudy
#DB_USER=simulator
#DB_PASSWORD=simulator

# Flyway (optional)
#DB_MIGRATE=true

#GEMINI_API_KEY=coloca_a_chave_do_gemini
#GEMINI_MODEL=gemini-2.5-flash

#GROQ_API_KEY=coloca_a_chave_do_groq
#GROQ_MODEL=openai/gpt-oss-120b

# Supabase (future option)
#DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
#DB_USER=postgres
#DB_PASSWORD=<password>
#SUPABASE_URL=https://<project-ref>.supabase.co
#SUPABASE_ANON_KEY=<anon-key>
#SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
