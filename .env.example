# Safe default for machines without PostgreSQL local
TESTE=false

# Optional explicit override
# If set, DB_ENABLED wins over TESTE
#DB_ENABLED=true

# Local Postgres (enable when the database is available)
#DB_URL=jdbc:postgresql://localhost:5432/simulatorbolsastudy
#DB_USER=simulator
#DB_PASSWORD=simulator

# Flyway (optional)
#DB_MIGRATE=true

# Supabase (future option)
#DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
#DB_USER=postgres
#DB_PASSWORD=<password>
