# Local Postgres (docker-compose)
DB_URL=jdbc:postgresql://localhost:5432/simulatorbolsastudy
DB_USER=simulator
DB_PASSWORD=simulator

# Optional
# Use one of the switches below:
# - DB_ENABLED=true|false (wins if set)
# - TESTE=true|false (alias: true => habilita BD; false => modo navegação)
DB_ENABLED=true
TESTE=true

# Flyway (opcional)
#DB_MIGRATE=true

# Supabase (quando migrar)
# DB_URL=jdbc:postgresql://<host>:5432/postgres?sslmode=require
# DB_USER=postgres
# DB_PASSWORD=<password>
