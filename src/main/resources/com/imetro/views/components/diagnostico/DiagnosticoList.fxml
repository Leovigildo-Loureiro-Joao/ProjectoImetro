<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane stylesheets="@../../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.candidato.diagnosticos.DiagnosticoListController">
   <children>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox prefHeight="113.0" prefWidth="658.0" spacing="10.0">
                     <children>
                        <Label fx:id="pageTitleLabel" styleClass="h3-thin-big" text="FACA AGORA SEU DIAGNOSTICO" />
                        <Label fx:id="pageSubtitleLabel" styleClass="h3-thin" text="Seus diagnosticos" />
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                  </VBox>
                  <JFXButton fx:id="massButton" disable="true" onAction="#DiagnosticoMassa" prefHeight="26.0" prefWidth="205.0" styleClass="btn-primary" text="Iniciar diagnostico em massa" />
                  <JFXButton fx:id="resetButton" disable="true" minHeight="39.0" onAction="#ResetData" prefHeight="26.0" prefWidth="158.0" styleClass="btn-primary-two" text="Resetar diagnosticos" />
               </children>
            </HBox>
            <FlowPane fx:id="diagnosticosPane" hgap="16.0" minWidth="1122.0" prefHeight="581.0" prefWidth="1122.0" prefWrapLength="740.0" vgap="16.0" visible="true">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </FlowPane>
         </children>
      </VBox>
   </children>
</StackPane>
