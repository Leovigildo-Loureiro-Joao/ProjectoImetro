<StackPane prefHeight="665.0" prefWidth="1060.0" stylesheets="@../../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.candidato.diagnosticos.DiagnosticoListController">
   <children>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="84.0" prefWidth="1122.0" spacing="10.0">
               <children>
                  <VBox prefHeight="84.0" prefWidth="733.0" spacing="10.0">
                     <children>
                        <Label fx:id="pageTitleLabel" styleClass="h3-thin-big" text="FACA AGORA SEU DIAGNOSTICO" />
                        <Label fx:id="pageSubtitleLabel" styleClass="h3-thin" text="Seus diagnosticos" />
                     </children>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <effect>
                        <Blend />
                     </effect>
                  </VBox>
                  <JFXButton fx:id="massButton" disable="true" onAction="#DiagnosticoMassa" prefHeight="26.0" prefWidth="205.0" styleClass="btn-primary" text="Iniciar diagnostico em massa" />
                  <JFXButton fx:id="resetButton" disable="true" minHeight="39.0" onAction="#ResetData" prefHeight="26.0" prefWidth="158.0" styleClass="btn-primary-two" text="Resetar diagnosticos" />
