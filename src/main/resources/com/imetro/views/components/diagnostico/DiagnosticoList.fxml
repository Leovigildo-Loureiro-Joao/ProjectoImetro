            </HBox>
            <HBox prefHeight="581.0" prefWidth="1073.0" spacing="10.0">
               <children>
                  <FlowPane fx:id="diagnosticosPane" hgap="16.0" minWidth="601.0" prefHeight="581.0" prefWidth="694.0" prefWrapLength="740.0" vgap="16.0" visible="true">
                     <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                     </padding>
                  </FlowPane>
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <VBox maxHeight="453.0" maxWidth="340.0" minHeight="453.0" minWidth="340.0" prefHeight="453.0" prefWidth="340.0" spacing="10.0">
                     <children>
                        <Label style="-fx-text-fill: -color-secondary;" styleClass="mid-h2" text="Faça seu diagnostico">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <Label text="Diagnostique suas skills de modo a verificares quais sao seus pontos fracos de modo a ter um plano de estudo mais sollido" wrapText="true">
                           <styleClass>
                              <String fx:value="h3-thin-big" />
                              <String fx:value="text" />
                           </styleClass></Label>
                        <ImageView fitHeight="290.0" fitWidth="298.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../../../assets/imgs/9..png" />
                           </image>
                        </ImageView>
                     </children>
                     <styleClass>
                        <String fx:value="achievement-card" />
                        <String fx:value="card" />
                     </styleClass>
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <HBox.margin>
                        <Insets />
                     </HBox.margin>
                  </VBox>
               </children>
               <VBox.margin>
                  <Insets right="10.0" />
               </VBox.margin>
