<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8.0" stylesheets="@../../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.candidato.resultados.ResultadoRecomendacao">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <Label styleClass="h3-thin" text="Recomendacao" />
            <Region HBox.hgrow="ALWAYS" />
            <JFXButton fx:id="btnToggleRecomendacao" onAction="#togglePainelRecomendacao" prefHeight="34.0" prefWidth="170.0" styleClass="btn-secondary" text="Ver recomendacao" />
         </children>
      </HBox>
      <Label fx:id="recomendacaoValue" styleClass="muted" text="-" wrapText="true" />
      <VBox fx:id="painelRecomendacao" managed="false" spacing="10.0" styleClass="result-detail-panel" visible="false">
         <children>
            <Accordion fx:id="recommendationAccordion">
               <panes>
                  <TitledPane animated="false" text="Observacoes gerais">
                     <content>
                        <Label fx:id="observacoesDetalheValue" prefWidth="760.0" styleClass="question-side-copy" text="-" wrapText="true" />
                     </content>
                  </TitledPane>
                  <TitledPane animated="false" text="Leitura guiada">
                     <content>
                        <Label fx:id="leituraDetalheValue" prefWidth="760.0" styleClass="question-side-copy" text="-" wrapText="true" />
                     </content>
                  </TitledPane>
                  <TitledPane animated="false" text="Trilho por subtópico">
                     <content>
                        <VBox fx:id="trilhaDetalheBox" spacing="10.0" />
                     </content>
                  </TitledPane>
               </panes>
            </Accordion>
         </children>
         <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
