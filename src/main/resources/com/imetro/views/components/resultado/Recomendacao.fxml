<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<HBox xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.candidato.resultados.ResultadoRecomendacaoCardsController">
   <children>
      <VBox alignment="TOP_LEFT" fillWidth="false" spacing="14.0" stylesheets="@../../../../../styles/candidato-layout.css">
         <padding>
            <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
         </padding>
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="h3-thin" text="Recomendação" />
                  <Label fx:id="subtituloLabel" styleClass="muted" text="Cards simples gerados a partir do teu planeamento atual." wrapText="true" />
               </children>
            </VBox>
            <VBox fx:id="cardsBox" fillWidth="false" spacing="12.0" />
         </children>
      </VBox>
      <Region prefHeight="450.0" prefWidth="63.0" HBox.hgrow="ALWAYS" />
      <VBox alignment="TOP_CENTER" maxHeight="450.0" minHeight="450.0" prefHeight="450.0" prefWidth="279.0" spacing="10.0">
         <children>
            <Label style="-fx-text-fill: -color-secondary;" styleClass="mid-h2" text="Cada recomendação">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Label>
            <Label text="E recomendado visualizar esta aba pois podes ter acesso a dicas otimas de como melhor e prosseguir para os teus estudos" textAlignment="CENTER" wrapText="true">
               <styleClass>
                  <String fx:value="h3-thin-big" />
                  <String fx:value="text" />
               </styleClass>
            </Label>
            <ImageView fitHeight="299.0" fitWidth="316.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../../assets/imgs/6.png" />
               </image>
            </ImageView>
         </children>
         <styleClass>
            <String fx:value="card" />
            <String fx:value="achievement-card" />
         </styleClass>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</HBox>
