<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1120.0" spacing="18.0" styleClass="page" stylesheets="@../../../../../styles/orientador-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label styleClass="big-h1" text="Configuracao" />
        <Label styleClass="mentor-copy" text="Preferencias do modulo do orientador, alertas e formato de trabalho para manter o fluxo mais organizado." wrapText="true" />

        <HBox spacing="18.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="mentor-settings-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-section-title" text="Alertas e notificacoes" />
                        <CheckBox mnemonicParsing="false" selected="true" text="Receber aviso para relatorios pendentes" />
                        <CheckBox mnemonicParsing="false" selected="true" text="Mostrar candidatos de risco logo no topo" />
                        <CheckBox mnemonicParsing="false" text="Receber resumo diario por email" />
                        <JFXComboBox prefHeight="40.0" prefWidth="280.0" promptText="Frequencia dos alertas" styleClass="mentor-filter-field" />
                    </children>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="mentor-settings-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-section-title" text="Visualizacao" />
                        <CheckBox mnemonicParsing="false" selected="true" text="Abrir o dashboard como pagina inicial" />
                        <CheckBox mnemonicParsing="false" selected="true" text="Destacar metricas com maior variacao" />
                        <CheckBox mnemonicParsing="false" text="Ocultar blocos em modo resumo" />
                        <JFXComboBox prefHeight="40.0" prefWidth="280.0" promptText="Escala preferida dos indicadores" styleClass="mentor-filter-field" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <VBox spacing="14.0" styleClass="mentor-settings-card">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="mentor-section-title" text="Partilha e privacidade" />
                <CheckBox mnemonicParsing="false" selected="true" text="Anexar sempre o proximo passo nas partilhas para candidatos" />
                <CheckBox mnemonicParsing="false" selected="true" text="Exigir validacao antes de enviar alertas de risco aos encarregados" />
                <CheckBox mnemonicParsing="false" text="Permitir exportacao automatica em PDF" />
                <HBox spacing="12.0">
                    <children>
                        <JFXButton prefHeight="40.0" prefWidth="170.0" styleClass="btn-primary" text="Guardar preferencias" />
                        <JFXButton prefHeight="40.0" prefWidth="150.0" styleClass="mentor-ghost-button" text="Restaurar base" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</VBox>
