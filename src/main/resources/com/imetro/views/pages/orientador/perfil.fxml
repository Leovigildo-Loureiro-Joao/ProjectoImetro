<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXComboBox?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="1120.0" spacing="18.0" styleClass="page" stylesheets="@../../../../../styles/orientador-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox spacing="18.0">
            <children>
                <HBox HBox.hgrow="ALWAYS" spacing="18.0" styleClass="mentor-hero-card">
                    <padding>
                        <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                    </padding>
                    <children>
                        <StackPane styleClass="profile-avatar-shell">
                            <children>
                                <Label text="OR">
                                    <styleClass>
                                        <String fx:value="avatar-initials" />
                                        <String fx:value="avatar-initials-large" />
                                    </styleClass>
                                </Label>
                            </children>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="mentor-badge" text="Perfil do orientador" />
                                <Label styleClass="big-h1" text="Orlando Ramos" />
                                <Label styleClass="h3-thin-big" text="orlando.ramos@imetro.co.ao" />
                                <Label styleClass="mentor-copy" text="Especialista em acompanhamento academico, consolidacao de bases e planos curtos de alta frequencia." wrapText="true" />
                                <FlowPane hgap="10.0" vgap="10.0">
                                    <children>
                                        <Label styleClass="mentor-chip" text="Matematica" />
                                        <Label text="Fisica">
                                            <styleClass>
                                                <String fx:value="mentor-chip" />
                                                <String fx:value="mentor-chip-muted" />
                                            </styleClass>
                                        </Label>
                                        <Label text="Mentoria individual">
                                            <styleClass>
                                                <String fx:value="mentor-chip" />
                                                <String fx:value="mentor-chip-muted" />
                                            </styleClass>
                                        </Label>
                                    </children>
                                </FlowPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <VBox prefWidth="320.0" spacing="12.0" styleClass="mentor-panel-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-section-title" text="Resumo rapido" />
                        <Label styleClass="mentor-inline-value" text="48 mentorados" />
                        <Label styleClass="muted" text="9 disciplinas acompanhadas e tempo medio de resposta abaixo da meta interna." wrapText="true" />
                        <Label styleClass="mentor-chip" text="Disponivel em horario alargado" />
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="18.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="mentor-panel-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label styleClass="mentor-section-title" text="Dados do perfil" />
                                <Region HBox.hgrow="ALWAYS" />
                                <JFXButton prefHeight="38.0" prefWidth="150.0" styleClass="btn-primary" text="Actualizar perfil" />
                            </children>
                        </HBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h3-thin" text="Nome completo" />
                                <TextField prefHeight="40.0" text="Orlando Ramos" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h3-thin" text="Email" />
                                <TextField editable="false" prefHeight="40.0" text="orlando.ramos@imetro.co.ao" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h3-thin" text="Area principal" />
                                <TextField prefHeight="40.0" text="Mentoria academica e acompanhamento de progresso" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h3-thin" text="Nova senha" />
                                <PasswordField prefHeight="40.0" promptText="Actualizar senha de acesso" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox prefWidth="360.0" spacing="14.0" styleClass="mentor-panel-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-section-title" text="Disponibilidade" />
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h3-thin" text="Janela principal" />
                                <JFXComboBox prefHeight="40.0" prefWidth="300.0" promptText="08h00 - 17h00" styleClass="mentor-filter-field" />
                            </children>
                        </VBox>
                        <VBox spacing="8.0">
                            <children>
                                <Label styleClass="h3-thin" text="Canal preferido" />
                                <JFXComboBox prefHeight="40.0" prefWidth="300.0" promptText="Email e resumo na plataforma" styleClass="mentor-filter-field" />
                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="mentor-surface">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                            <children>
                                <Label styleClass="mentor-stat-label" text="Nota" />
                                <Label styleClass="h1-thin" text="Perfis de risco alto devem receber retorno no mesmo dia sempre que possivel." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>

        <HBox spacing="18.0">
            <children>
                <VBox HBox.hgrow="ALWAYS" spacing="14.0" styleClass="mentor-panel-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-section-title" text="Especialidades e foco" />
                        <FlowPane hgap="10.0" prefWrapLength="620.0" vgap="10.0">
                            <children>
                                <Label styleClass="mentor-chip" text="Diagnostico rapido" />
                                <Label styleClass="mentor-chip" text="Reforco de base" />
                                <Label styleClass="mentor-chip" text="Plano semanal" />
                                <Label text="Contacto com encarregados">
                                    <styleClass>
                                        <String fx:value="mentor-chip" />
                                        <String fx:value="mentor-chip-muted" />
                                    </styleClass>
                                </Label>
                                <Label text="Gestao de risco academico">
                                    <styleClass>
                                        <String fx:value="mentor-chip" />
                                        <String fx:value="mentor-chip-muted" />
                                    </styleClass>
                                </Label>
                            </children>
                        </FlowPane>
                        <VBox spacing="10.0" styleClass="mentor-note-card">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                            <children>
                                <Label styleClass="mentor-stat-label" text="Abordagem de mentoria" />
                                <Label styleClass="h1-thin" text="Reforco curto, frequente e com metas muito concretas para manter o candidato em accao." wrapText="true" />
                            </children>
                        </VBox>
                    </children>
                </VBox>

                <VBox prefWidth="360.0" spacing="14.0" styleClass="mentor-panel-card">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-section-title" text="Metricas pessoais" />
                        <VBox spacing="10.0" styleClass="mentor-surface">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                            <children>
                                <Label styleClass="mentor-stat-label" text="Tempo medio de resposta" />
                                <Label styleClass="mentor-inline-value" text="18h" />
                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="mentor-surface">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                            <children>
                                <Label styleClass="mentor-stat-label" text="Partilhas concluidas" />
                                <Label styleClass="mentor-inline-value" text="29" />
                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="mentor-surface">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                            <children>
                                <Label styleClass="mentor-stat-label" text="Satisfacao da turma" />
                                <Label styleClass="mentor-inline-value" text="4.8/5" />
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
