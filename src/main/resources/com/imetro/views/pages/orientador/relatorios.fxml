                            </children>
                        </VBox>
                        <VBox spacing="10.0" styleClass="mentor-note-card">
                            <padding>
                                <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
                            </padding>
                            <children>
                                <Label styleClass="mentor-stat-label" text="Padrao 03" />
