                                    </padding>
                                    <children>
                                        <Label styleClass="mentor-stat-label" text="Acerto medio" />
                                        <Label styleClass="mentor-inline-value" text="84%" />
                                    </children>
                                </VBox>
                                <VBox prefWidth="170.0" spacing="4.0" styleClass="mentor-inline-metric">
                                    <padding>
                                        <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
