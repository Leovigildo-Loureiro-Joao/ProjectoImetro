                                </HBox>
                                <Label styleClass="muted" text="Sinais de baixa constancia em Quimica e atraso no retorno das tarefas." wrapText="true" />
                                <ProgressBar progress="0.58" styleClass="mentor-progress mentor-progress-warn" />
                            </children>
