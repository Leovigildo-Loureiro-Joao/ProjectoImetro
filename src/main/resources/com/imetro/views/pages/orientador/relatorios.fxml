                                        <Label styleClass="muted" text="baseada nos ultimos 6 ciclos de pratica" wrapText="true" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                        <HBox spacing="12.0">
                            <children>
                                <VBox prefWidth="170.0" spacing="4.0" styleClass="mentor-inline-metric">
