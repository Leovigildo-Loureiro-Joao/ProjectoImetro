                                            <styleClass>
                                                <String fx:value="mentor-badge" />
                                                <String fx:value="mentor-badge-danger" />
                                            </styleClass>
                                        </Label>
                                    </children>
                                </HBox>
                                <Label styleClass="muted" text="A turma responde bem a exercicios curtos, mas continua a quebrar em blocos longos com tempo." wrapText="true" />
