                    </children>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6.0" styleClass="mentor-stat-card">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-stat-label" text="Melhor frente" />
                        <Label styleClass="mentor-stat-value" text="Matematica" />
                        <Label styleClass="mentor-stat-sub" text="Subida sustentada em precisao e resolucao com autonomia." wrapText="true" />
                    </children>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="6.0" styleClass="mentor-stat-card">
                    <padding>
                        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
                    </padding>
                    <children>
                        <Label styleClass="mentor-stat-label" text="Maior risco actual" />
                        <Label styleClass="mentor-stat-value" text="Biologia" />
