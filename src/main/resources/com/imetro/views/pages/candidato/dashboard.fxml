<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="tela" minHeight="982.0" prefHeight="982.0" prefWidth="1211.0" spacing="20.0" styleClass="page" stylesheets="@../../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.candidato.DashboardOrientadoController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" />
    </padding>
   <HBox alignment="CENTER_LEFT" prefHeight="64.0" prefWidth="1175.0" spacing="20.0">
      <children>
         <VBox prefHeight="60.0" prefWidth="1040.0" spacing="8.0">
            <children>
               <Label fx:id="welcome" styleClass="big-h1" text="Boa noite! Seja Equilibrado" />
               <Label fx:id="desc" styleClass="h3-bold" text="Pronto para mais um salto de conhecimento" wrapText="true" />
            </children>
         </VBox>
         <Region prefHeight="60.0" prefWidth="735.0" HBox.hgrow="ALWAYS" />
         <Label fx:id="localDate" styleClass="muted" text="" wrapText="true" />
      </children>
      <padding>
         <Insets bottom="4.0" top="4.0" />
      </padding>
   </HBox>
   <HBox fx:id="guidedFlowBox" prefHeight="80.0" styleClass="card" spacing="16.0" alignment="CENTER_LEFT">
      <padding>
         <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
      </padding>
      <children>
         <StackPane fx:id="stepCircle" minHeight="48.0" minWidth="48.0" maxHeight="48.0" maxWidth="48.0" styleClass="guided-step-circle">
            <Label fx:id="stepNumber" styleClass="h3-bold" text="1" />
         </StackPane>
         <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <Label fx:id="stepTitle" styleClass="h3-bold" text="Próxima ação" />
            <Label fx:id="stepDescription" styleClass="compact-copy" text="Carregando..." wrapText="true" />
         </VBox>
         <JFXButton fx:id="stepActionButton" onAction="#onStepAction" prefHeight="44.0" prefWidth="280.0" styleClass="btn-primary" text="CONTINUAR" />
      </children>
   </HBox>
   <HBox prefHeight="320.0" prefWidth="1175.0" spacing="20.0">
      <children>
         <AnchorPane HBox.hgrow="ALWAYS">
            <children>
               <VBox layoutX="12.0" layoutY="10.0" prefHeight="314.0" prefWidth="691.0" spacing="16.0">
                  <children>
                     <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <children>
                           <VBox spacing="4.0">
                              <children>
                                 <Label styleClass="timeline-pill" text="Resumo geral" />
                                 <Label styleClass="h1-thin" text="Seu progresso geral" />
                              </children>
                           </VBox>
                           <Region HBox.hgrow="ALWAYS" />
                           <VBox alignment="CENTER_RIGHT" spacing="7.0">
                              <children>
                                 <Label styleClass="muted" text="Progresso geral" />
                                 <Label fx:id="progressText" styleClass="mid-h2" text="0% progresso">
                                    <VBox.margin>
                                       <Insets bottom="-2.0" />
                                    </VBox.margin></Label>
                              </children>
                           </VBox>
                           <VBox alignment="CENTER_RIGHT" prefHeight="54.0" prefWidth="93.0" spacing="10.0">
                              <children>
                                 <Label styleClass="muted" text="Próximo nível" />
                                 <Label fx:id="next_level" styleClass="h3-bold" text="INTERMEDIÁRIO" />
                              </children>
                           </VBox>
                        </children>
                     </HBox>
                     <HBox spacing="20.0">
                        <children>
                           <StackPane fx:id="progresso" maxHeight="120.0" maxWidth="120.0" minHeight="120.0" minWidth="120.0" prefHeight="120.0" prefWidth="120.0" />
                           <VBox prefHeight="241.0" prefWidth="509.0" spacing="10.0" HBox.hgrow="ALWAYS">
                              <children>
                                 <Label fx:id="heroSummary" alignment="TOP_LEFT" prefHeight="119.0" prefWidth="508.0" styleClass="hero-copy" text="Planeamento personalizado a carregar..." wrapText="true" />
                                 <Label fx:id="heroFocus" styleClass="compact-copy" text="Foco actual: -" wrapText="true" />
                                 <HBox spacing="12.0">
                                    <children>
                                       <JFXButton onAction="#StartExam" prefHeight="52.0" prefWidth="236.0" styleClass="btn-primary" text="INICIAR EXAME ADAPTATIVO" />
                                       <JFXButton onAction="#StartDiagnostic" prefHeight="52.0" prefWidth="236.0" styleClass="btn-primary-two" text="EXECUTAR DIAGNOSTICO" />
                                    </children>
                                 </HBox>
                              </children>
                           </VBox>
                        </children>
                        <VBox.margin>
                           <Insets top="20.0" />
                        </VBox.margin>
                     </HBox>
                  </children>
                  <padding>
                     <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                  </padding>
                  <styleClass>
                     <String fx:value="card" />
                     <String fx:value="hero-gradient-card shadow" />
                  </styleClass>
               </VBox>
               <ImageView fx:id="imgEmotiv" fitHeight="150.0" fitWidth="200.0" layoutX="316.0" layoutY="-68.0" pickOnBounds="true" preserveRatio="true">
                  <image>
                     <Image url="@../../../assets/imgs/13.png" />
                  </image>
               </ImageView>
            </children>
         </AnchorPane>
         <VBox prefHeight="300.0" prefWidth="441.0" spacing="12.0" HBox.hgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT" spacing="12.0">
                  <children>
                     <VBox spacing="4.0">
                        <children>
                           <Label styleClass="timeline-pill" text="Sequência" />
                           <Label fx:id="sequenceTitle" styleClass="h1-thin" text="Ritmo dos últimos 7 dias" />
                        </children>
                     </VBox>
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="sequenceBadge" styleClass="badge-new" text="0 dias activos" />
                  </children>
               </HBox>
               <Label fx:id="sequenceSummary" styleClass="compact-copy" text="O gráfico mostra a taxa de sucesso diária." wrapText="true" />
               <AreaChart fx:id="areaActivityChart" animated="false" legendVisible="false" prefHeight="175.0" prefWidth="403.0" styleClass="report-chart">
                  <xAxis>
                     <CategoryAxis side="BOTTOM" />
                  </xAxis>
                  <yAxis>
                     <NumberAxis side="LEFT" />
                  </yAxis>
               </AreaChart>
            </children>
            <padding>
               <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <styleClass>
               <String fx:value="card" />
               <String fx:value="sequence-card shadow" />
            </styleClass>
         </VBox>
      </children>
   </HBox>
   <HBox prefHeight="529.0" prefWidth="1175.0" spacing="18.0">
      <children>
         <VBox prefHeight="290.0" prefWidth="400.0" spacing="12.0" HBox.hgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT">
                  <children>
                     <Label styleClass="timeline-pill" text="Conquistas" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="achievementBadge" styleClass="badge-new" text="Possível" />
                  </children>
               </HBox>
               <Label fx:id="achievementTitle" styleClass="h1-thin" text="Próxima conquista" wrapText="true" />
               <Label fx:id="achievementSummary" styleClass="compact-copy" text="As três mais próximas de desbloquear aparecem aqui." wrapText="true" />
               <HBox fx:id="achievementCardsBox" alignment="CENTER_LEFT" spacing="8.0" styleClass="achievement-cards-box" />
               <Label fx:id="achievementMeta" styleClass="muted" text="Cada card mostra a medalha, o objetivo e o que falta." wrapText="true" />
            </children>
            <padding>
               <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <styleClass>
               <String fx:value="card" />
               <String fx:value="achievement-card shadow" />
            </styleClass>
         </VBox>
          <VBox prefWidth="358.0" spacing="12.0" HBox.hgrow="ALWAYS">
             <children>
                <HBox alignment="CENTER_LEFT">
                   <children>
                      <Label styleClass="timeline-pill" text="Foco de Estudo" />
                      <Region HBox.hgrow="ALWAYS" />
                      <Label fx:id="planBadge" styleClass="badge-new" text="Hoje" />
                   </children>
                </HBox>
                <Label fx:id="planTitle" styleClass="h1-thin" text="Foco actual" wrapText="true" />
                <Label fx:id="planSummary" styleClass="compact-copy" text="Detalhes do teu foco de estudo aparecem aqui." wrapText="true" />
                <VBox spacing="4.0">
                   <children>
                      <Label fx:id="planFocus" styleClass="muted" text="Foco actual: -" wrapText="true" />
                      <Label fx:id="planMeta" styleClass="muted" text="Acerto médio e ritmo a carregar." wrapText="true" />
                   </children>
                </VBox>
             </children>
             <padding>
                <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
             </padding>
             <styleClass>
                <String fx:value="card" />
                <String fx:value="plan-card shadow" />
             </styleClass>
          </VBox>
         <VBox prefWidth="358.0" spacing="12.0" HBox.hgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT">
                  <children>
                     <Label styleClass="timeline-pill" text="Disciplinas" />
                     <Region HBox.hgrow="ALWAYS" />
                     <Label fx:id="disciplineBadge" styleClass="badge-new" text="0 disciplinas" />
                  </children>
               </HBox>
               <Label fx:id="disciplineSummary" styleClass="compact-copy" text="Progressão actual por disciplina." wrapText="true" />
               <ListView fx:id="status_disciplina" prefHeight="422.0" prefWidth="327.0" styleClass="discipline-progress-list" />
            </children>
            <padding>
               <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
            </padding>
            <styleClass>
               <String fx:value="card" />
               <String fx:value="discipline-card shadow" />
            </styleClass>
         </VBox>
      </children>
   </HBox>
</VBox>
