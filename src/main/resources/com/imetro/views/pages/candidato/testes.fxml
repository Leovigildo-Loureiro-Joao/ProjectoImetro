<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXToggleNode?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="735.0" prefWidth="820.0" styleClass="page" stylesheets="@../../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.TesteAdaptativoController">
   <children>
      <VBox alignment="TOP_LEFT" prefHeight="722.0" prefWidth="820.0" spacing="15.0" styleClass="placeholder-card" AnchorPane.bottomAnchor="-13.0" AnchorPane.leftAnchor="-2.0" AnchorPane.rightAnchor="2.0" AnchorPane.topAnchor="-2.0">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         
         <!-- CABECALHO -->
         <HBox alignment="CENTER_LEFT" spacing="70.0">
            <children>
               <VBox spacing="8.0">
                  <children>
                     <Label styleClass="big-h1" text="Teste Adaptativo" />
                     <Label styleClass="muted" text="A dificuldade se ajusta ao seu desempenho em tempo real" />
                  </children>
               </VBox>
            </children>
         </HBox>
         
         <AnchorPane prefHeight="609.0" prefWidth="778.0" VBox.vgrow="ALWAYS">
            <children>
               
               <!-- TELA DE SELECAO (START) -->
               <VBox fx:id="start" prefHeight="650.0" prefWidth="782.0" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                  <children>
                     <Label styleClass="h3-thin" text="Selecione uma disciplina para iniciar o teste adaptativo" />
                     <ScrollPane fitToHeight="true" fitToWidth="true" prefHeight="550.0" VBox.vgrow="ALWAYS">
                        <content>
                           <VBox fx:id="disciplinasContainer" spacing="16.0">
                              <padding>
                                 <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                              </padding>
                           </VBox>
                        </content>
                     </ScrollPane>
                  </children>
               </VBox>
               
               <!-- TELA DO TESTE ADAPTATIVO -->
               <VBox fx:id="testeContainer" prefHeight="650.0" prefWidth="782.0" spacing="15.0" visible="false" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                  <children>
                     <StackPane>
                        <children>
                           <!-- OVERLAY DE CARREGAMENTO -->
                           <StackPane fx:id="loadingOverlay" styleClass="loading-overlay" visible="false">
                              <children>
                                 <VBox alignment="CENTER" spacing="30.0" styleClass="loading-card">
                                    <children>
                                       <Label styleClass="loading-title" text="Preparando teste adaptativo..." />
                                       <ProgressBar fx:id="loadingProgress" prefHeight="8.0" prefWidth="300.0" styleClass="loading-progress-bar" />
                                       <Label fx:id="loadingMessage" styleClass="loading-message" text="Carregando questoes..." />
                                    </children>
                                 </VBox>
                              </children>
                           </StackPane>
                           
                           <VBox fx:id="tela" spacing="15.0">
                              <children>
                                 <!-- HEADER DA QUESTAO -->
                                 <HBox alignment="CENTER_LEFT" prefHeight="97.0" prefWidth="778.0" spacing="20.0">
                                    <children>
                                       <HBox spacing="20.0">
                                          <children>
                                             <StackPane fx:id="circleProgressContainer" prefHeight="70.0" prefWidth="70.0" />
                                             <VBox alignment="CENTER_LEFT" spacing="5.0">
                                                <children>
                                                   <Label fx:id="nomeDisc" styleClass="h3-thin" text="MATEMATICA" />
                                                   <Label fx:id="nPergunta" styleClass="h1" text="Questao 1" />
                                                </children>
                                             </VBox>
                                          </children>
                                       </HBox>
                                       
                                       <Region HBox.hgrow="ALWAYS" />
                                       
                                       <!-- INDICADORES ADAPTATIVOS -->
                                       <VBox alignment="CENTER" spacing="5.0">
                                          <children>
                                             <Label styleClass="h3-thin" text="NIVEL" />
                                             <Label fx:id="nivelAtual" styleClass="h1" text="MEDIO" />
                                          </children>
                                       </VBox>
                                       
                                       <Separator orientation="VERTICAL" prefHeight="40.0" />
                                       
                                       <VBox alignment="CENTER" spacing="5.0">
                                          <children>
                                             <Label styleClass="h3-thin" text="DIFICULDADE" />
                                             <Label fx:id="dificuldadeAtual" styleClass="h1" text="**" />
                                          </children>
                                       </VBox>
                                       
                                       <Separator orientation="VERTICAL" prefHeight="40.0" />
                                       
                                       <VBox alignment="CENTER" spacing="5.0">
                                          <children>
                                             <HBox alignment="CENTER" spacing="5.0">
                                                <children>
                                                   <ImageView fitHeight="20.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                                      <image>
                                                         <Image url="@../../../assets/imgs/time_100px.png" />
                                                      </image>
                                                   </ImageView>
                                                   <Label styleClass="h3-thin" text="TEMPO" />
                                                </children>
                                             </HBox>
                                             <Label fx:id="tempo" styleClass="h1" text="00:00" />
                                          </children>
                                       </VBox>
                                       
                                       <VBox alignment="CENTER" spacing="5.0">
                                          <children>
                                             <HBox alignment="CENTER" spacing="5.0">
                                                <children>
                                                   <ImageView fitHeight="20.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                                      <image>
                                                         <Image url="@../../../assets/imgs/verified_badge_96px.png" />
                                                      </image>
                                                   </ImageView>
                                                   <Label styleClass="h3-thin" text="ACERTOS" />
                                                </children>
                                             </HBox>
                                             <Label fx:id="acertosLabel" styleClass="h1" text="0" />
                                          </children>
                                       </VBox>
                                       
                                       <VBox alignment="CENTER" spacing="5.0">
                                          <children>
                                             <HBox alignment="CENTER" spacing="5.0">
                                                <children>
                                                   <ImageView fitHeight="20.0" fitWidth="16.0" pickOnBounds="true" preserveRatio="true">
                                                      <image>
                                                         <Image url="@../../../assets/imgs/error_96px.png" />
                                                      </image>
                                                   </ImageView>
                                                   <Label styleClass="h3-thin" text="ERROS" />
                                                </children>
                                             </HBox>
                                             <Label fx:id="errosLabel" styleClass="h1" text="0" />
                                          </children>
                                       </VBox>
                                    </children>
                                 </HBox>
                                 
                                 <!-- CORPO DA QUESTAO -->
                                 <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="card-blur">
                                    <content>
                                       <VBox prefWidth="720.0" spacing="20.0">
                                          <padding>
                                             <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                                          </padding>
                                          <children>
                                             
                                             <!-- ENUNCIADO -->
                                             <VBox spacing="10.0">
                                                <children>
                                                   <HBox>
                                                      <children>
                                                         <VBox alignment="CENTER_LEFT" spacing="10.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                               <Label fx:id="bloco1" style="-fx-font-size: 16;" styleClass="h3-thin" text="Aqui vai o texto do enunciado da questao." wrapText="true" />
                                                               <Label fx:id="bloco2" styleClass="h3-thin" text="" wrapText="true" />
                                                            </children>
                                                            <padding>
                                                               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                                                            </padding>
                                                         </VBox>
                                                         <Separator orientation="VERTICAL" />
                                                         <ImageView fx:id="imgBloco2" fitHeight="150.0" preserveRatio="true" visible="false" />
                                                      </children>
                                                   </HBox>
                                                </children>
                                             </VBox>
                                             
                                             <Separator />
                                             
                                             <!-- FEEDBACK ADAPTATIVO -->
                                             <VBox fx:id="feedbackContainer" visible="false" spacing="10.0" styleClass="sub-card" alignment="CENTER">
                                                <padding>
                                                   <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
                                                </padding>
                                                <children>
                                                   <Label fx:id="feedbackIcon" styleClass="h1" text="OK" />
                                                   <Label fx:id="feedbackMessage" styleClass="h3-thin" text="Excelente! Subindo de nivel..." wrapText="true" alignment="CENTER" />
                                                </children>
                                             </VBox>
                                             
                                             <!-- ALTERNATIVAS -->
                                             <VBox>
                                                <children>
                                                   <Label styleClass="h3-thin" text="Selecione uma alternativa:" />
                                                   <VBox spacing="10.0">
                                                      <children>
                                                         <!-- Linha A-B -->
                                                         <HBox spacing="20.0">
                                                            <children>
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleA" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="A">
                                                                        <toggleGroup>
                                                                           <ToggleGroup fx:id="alternativas" />
                                                                        </toggleGroup>
                                                                     </JFXToggleNode>
                                                                     <Label fx:id="ResA" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                               
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleB" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="B" toggleGroup="$alternativas" />
                                                                     <Label fx:id="ResB" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                            </children>
                                                         </HBox>
                                                         
                                                         <!-- Linha C-D -->
                                                         <HBox spacing="20.0">
                                                            <children>
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleC" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="C" toggleGroup="$alternativas" />
                                                                     <Label fx:id="ResC" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                               
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleD" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="D" toggleGroup="$alternativas" />
                                                                     <Label fx:id="ResD" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                            </children>
                                                         </HBox>
                                                         
                                                         <!-- Linha E-F -->
                                                         <HBox spacing="20.0">
                                                            <children>
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleE" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="E" toggleGroup="$alternativas" />
                                                                     <Label fx:id="ResE" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                               
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleF" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="F" toggleGroup="$alternativas" />
                                                                     <Label fx:id="ResF" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                            </children>
                                                         </HBox>
                                                         
                                                         <!-- Linha G -->
                                                         <HBox spacing="20.0">
                                                            <children>
                                                               <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="toggle-option" HBox.hgrow="ALWAYS">
                                                                  <children>
                                                                     <JFXToggleNode fx:id="toggleG" maxWidth="46.0" minWidth="46.0" styleClass="toggle-letter" text="G" toggleGroup="$alternativas" />
                                                                     <Label fx:id="ResG" styleClass="radio-label" wrapText="true" />
                                                                  </children>
                                                               </HBox>
                                                            </children>
                                                         </HBox>
                                                      </children>
                                                   </VBox>
                                                </children>
                                             </VBox>
                                             
                                          </children>
                                       </VBox>
                                    </content>
                                 </ScrollPane>
                                 
                                 <!-- BOTOES -->
                                 <HBox alignment="CENTER_RIGHT" spacing="15.0">
                                    <children>
                                       <JFXButton fx:id="btnConfirmar" onAction="#confirmarResposta" prefHeight="40.0" prefWidth="160.0" styleClass="btn-secondary" text="Confirmar" />
                                       <JFXButton fx:id="btnProximo" onAction="#proximaQuestao" prefHeight="40.0" prefWidth="160.0" styleClass="btn-primary" text="Proxima Questao" disable="true" />
                                    </children>
                                 </HBox>
                              </children>
                           </VBox>
                        </children>
                     </StackPane>
                  </children>
               </VBox>
               
            </children>
         </AnchorPane>
         
      </VBox>
   </children>
</AnchorPane>