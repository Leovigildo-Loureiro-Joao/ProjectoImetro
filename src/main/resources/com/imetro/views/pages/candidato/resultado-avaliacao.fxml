<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" stylesheets="@../../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.controller.candidato.resultados.ResultadoAvaliacaoController">
   <styleClass>
      <String fx:value="page" />
      <String fx:value="placeholder-card" />
   </styleClass>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
   <children>
      <VBox spacing="6.0">
         <children>
            <Label fx:id="tituloAvaliacao" styleClass="big-h1" text="Resultado - Avaliacao" />
            <Label styleClass="muted" text="Resumo da sua performance final." />
            <ListView fx:id="sublist" minHeight="51.0" orientation="HORIZONTAL" prefHeight="51.0" prefWidth="1125.0">
               <styleClass>
                  <String fx:value="nav-bar" />
                  <String fx:value="sub" />
               </styleClass>
            </ListView>
            <Separator />
         </children>
      </VBox>
      <StackPane fx:id="swcDiagnos" prefHeight="497.0" prefWidth="1125.0" />
      <HBox alignment="CENTER_RIGHT" spacing="12.0">
         <children>
            <JFXButton onAction="#abrirDashboard" prefHeight="38.0" prefWidth="170.0" styleClass="btn-secondary" text="Ir ao Dashboard" />
            <JFXButton fx:id="btnRefazer" onAction="#refazerAvaliacao" prefHeight="38.0" prefWidth="170.0" styleClass="btn-primary" text="Refazer Avaliacao" />
         </children>
      </HBox>
   </children>
</VBox>
