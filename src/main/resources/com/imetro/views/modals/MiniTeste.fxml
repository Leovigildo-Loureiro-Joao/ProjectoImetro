<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import com.jfoenix.controls.JFXToggleNode?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="modal" maxHeight="700.0" maxWidth="650.0" minHeight="500.0" minWidth="600.0" prefHeight="600.0" prefWidth="620.0" spacing="12.0" stylesheets="@../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/21.0.11" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.modals.MiniTesteModalController">
   <padding>
      <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
   </padding>
   <styleClass>
      <String fx:value="card" />
      <String fx:value="card-blur" />
   </styleClass>
   <children>
      <!-- Header -->
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label fx:id="tituloLabel" styleClass="h2-thin" text="Mini teste" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="progressoLabel" styleClass="muted" text="1 de 5" />
         </children>
      </HBox>

      <ProgressBar fx:id="barraProgresso" maxWidth="1.7976931348623157E308" prefHeight="8.0" progress="0.0" />

      <!-- Questao area -->
      <VBox fx:id="questaoBox" spacing="12.0" VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="questaoNumeroLabel" styleClass="h3-thin" text="Questao 1 / 5" />
            <Label fx:id="topicoLabel" styleClass="timeline-pill" text="Topico" />
            <Label fx:id="subtopicoLabel" styleClass="muted" text="Subtopico" />

            <Label fx:id="enunciadoLabel" styleClass="h3-thin-big" text="Enunciado da questao aqui..." wrapText="true" />

            <FlowPane hgap="8.0" prefWrapLength="580.0" vgap="8.0">
               <children>
                  <JFXToggleNode fx:id="toggleA" alignment="CENTER_LEFT" contentDisplay="RIGHT" maxHeight="45.0" maxWidth="1.7976931348623157E308" minHeight="45.0" minWidth="100.0" prefHeight="45.0" styleClass="toggle-letter" text="A">
                     <toggleGroup>
                        <ToggleGroup fx:id="alternativas" />
                     </toggleGroup>
                     <graphic>
                        <Label fx:id="ResA" maxWidth="1.7976931348623157E308" prefHeight="36.0" styleClass="radio-label" translateX="10.0" wrapText="true">
                           <padding>
                              <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                           </padding>
                        </Label>
                     </graphic>
                  </JFXToggleNode>
                  <JFXToggleNode fx:id="toggleB" alignment="CENTER_LEFT" contentDisplay="RIGHT" maxHeight="45.0" maxWidth="1.7976931348623157E308" minHeight="45.0" minWidth="100.0" prefHeight="45.0" styleClass="toggle-letter" text="B" toggleGroup="$alternativas">
                     <graphic>
                        <Label fx:id="ResB" maxWidth="1.7976931348623157E308" prefHeight="36.0" styleClass="radio-label" translateX="10.0" wrapText="true">
                           <padding>
                              <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                           </padding>
                        </Label>
                     </graphic>
                  </JFXToggleNode>
                  <JFXToggleNode fx:id="toggleC" alignment="CENTER_LEFT" contentDisplay="RIGHT" maxHeight="45.0" maxWidth="1.7976931348623157E308" minHeight="45.0" minWidth="100.0" prefHeight="45.0" styleClass="toggle-letter" text="C" toggleGroup="$alternativas">
                     <graphic>
                        <Label fx:id="ResC" maxWidth="1.7976931348623157E308" prefHeight="36.0" styleClass="radio-label" translateX="10.0" wrapText="true">
                           <padding>
                              <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                           </padding>
                        </Label>
                     </graphic>
                  </JFXToggleNode>
                  <JFXToggleNode fx:id="toggleD" alignment="CENTER_LEFT" contentDisplay="RIGHT" maxHeight="45.0" maxWidth="1.7976931348623157E308" minHeight="45.0" minWidth="100.0" prefHeight="45.0" styleClass="toggle-letter" text="D" toggleGroup="$alternativas">
                     <graphic>
                        <Label fx:id="ResD" maxWidth="1.7976931348623157E308" prefHeight="36.0" styleClass="radio-label" translateX="10.0" wrapText="true">
                           <padding>
                              <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
                           </padding>
                        </Label>
                     </graphic>
                  </JFXToggleNode>
               </children>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </FlowPane>

            <Region VBox.vgrow="ALWAYS" />

            <HBox alignment="CENTER" spacing="20.0">
               <children>
                  <JFXButton fx:id="btnConfirmar" maxWidth="1.7976931348623157E308" onAction="#confirmarResposta" prefHeight="40.0" prefWidth="160.0" styleClass="btn-secondary" text="Confirmar" HBox.hgrow="ALWAYS" />
                  <JFXButton fx:id="btnProximo" disable="true" maxWidth="1.7976931348623157E308" onAction="#proximaQuestao" prefHeight="40.0" prefWidth="160.0" styleClass="btn-primary" text="Proxima" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Resultado area -->
      <VBox fx:id="resultadoBox" spacing="12.0" visible="false" managed="false" VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="resultadoTituloLabel" styleClass="h2-thin" text="Mini teste concluido" />
            <Label fx:id="resultadoDetalheLabel" styleClass="h3-thin-big" text="Resultado..." wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <JFXButton fx:id="btnFechar" onAction="#fecharResultado" prefHeight="38.0" prefWidth="120.0" styleClass="btn-primary" text="Fechar" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
