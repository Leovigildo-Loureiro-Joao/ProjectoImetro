<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.imetro.controllers.biblioteca.PdfViewerController"
            styleClass="pdf-viewer">

    <!-- Barra superior -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15"
              styleClass="viewer-header">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button fx:id="btnVoltar"
                    text="← Biblioteca"
                    styleClass="btn-flat"/>

            <VBox spacing="3">
                <Label fx:id="lblTitulo"
                       text="Cálculo Diferencial e Integral"
                       styleClass="livro-titulo"/>

                <Label fx:id="lblInfo"
                       text="Página 1 de 350"
                       styleClass="livro-info"/>
            </VBox>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnPesquisar"
                    text="🔍"
                    styleClass="icon-button"/>

            <Button fx:id="btnConfiguracoes"
                    text="⚙"
                    styleClass="icon-button"/>
        </HBox>
    </top>


    <!-- Área da página PDF -->
    <center>
        <StackPane styleClass="pdf-container">

            <ScrollPane fx:id="scrollPdf"
                        fitToWidth="true"
                        fitToHeight="true"
                        pannable="true"
                        styleClass="pdf-scroll">

                <content>

                    <StackPane alignment="CENTER"
                               styleClass="page-area">

                        <ImageView fx:id="imgPagina"
                                   preserveRatio="true"
                                   smooth="true"
                                   fitWidth="850"
                                   styleClass="pdf-page"/>

                    </StackPane>

                </content>

            </ScrollPane>

        </StackPane>

    </center>


    <!-- Navegação inferior -->
    <bottom>

        <HBox alignment="CENTER"
              spacing="20"
              styleClass="viewer-footer">

            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>

            <Button fx:id="btnAnterior"
                    text="◀ Página anterior"/>

            <Label fx:id="lblPaginaAtual"
                   text="1 / 350"
                   styleClass="pagina-atual"/>

            <Button fx:id="btnProxima"
                    text="Próxima página ▶"/>

        </HBox>

    </bottom>

</BorderPane>