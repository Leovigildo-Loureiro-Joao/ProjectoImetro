<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="modal" maxHeight="533.0" maxWidth="818.0" minHeight="533.0" prefHeight="533.0" prefWidth="818.0" spacing="18.0" stylesheets="@../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.modals.ResultadoCelebracaoModalController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="14.0">
         <children>
            <VBox spacing="6.0">
               <children>
                  <Label fx:id="badgeLabel" styleClass="celebration-badge" text="RESULTADO" />
                  <Label fx:id="headlineLabel" maxWidth="510.0" styleClass="celebration-title" text="Fechaste esta etapa com forca." wrapText="true" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <JFXButton onAction="#Continuar" prefHeight="40.0" prefWidth="132.0" styleClass="btn-secondary" text="Continuar" />
         </children>
      </HBox>
      <Label fx:id="summaryLabel" styleClass="hero-copy" text="Resumo da sessao." wrapText="true" />
      <HBox spacing="18.0">
         <children>
            <VBox alignment="CENTER" prefWidth="220.0" spacing="10.0" styleClass="celebration-score-card">
               <children>
                  <StackPane fx:id="performanceRingHost" prefHeight="150.0" prefWidth="150.0" />
                  <Label fx:id="performanceValueLabel" styleClass="h3-thin-big" text="0% de desempenho" />
                  <Label fx:id="performanceDetailLabel" maxWidth="180.0" styleClass="muted" text="0/0 respostas certas" textAlignment="CENTER" wrapText="true" />
               </children>
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
            </VBox>
            <VBox spacing="14.0" HBox.hgrow="ALWAYS">
               <children>
                  <VBox spacing="10.0" styleClass="celebration-track-card">
                     <children>
                        <Label fx:id="medalTitleLabel" styleClass="h3-thin" text="Rumo a nova medalha" />
                        <Label fx:id="medalMessageLabel" styleClass="muted" text="Mensagem da medalha" wrapText="true" />
                        <ProgressBar fx:id="medalProgressBar" prefHeight="10.0" prefWidth="420.0" progress="0.0" styleClass="celebration-progress" />
                        <Label fx:id="medalProgressDetailLabel" styleClass="question-side-caption" text="0/5 progresso" />
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
                  <VBox spacing="10.0" styleClass="celebration-track-card">
                     <children>
                        <Label fx:id="scholarshipTitleLabel" styleClass="h3-thin" text="Bolsa ficticia em mira" />
                        <Label fx:id="scholarshipMessageLabel" styleClass="muted" text="Mensagem da bolsa" wrapText="true" />
                        <ProgressBar fx:id="scholarshipProgressBar" prefHeight="10.0" prefWidth="420.0" progress="0.0" styleClass="celebration-progress celebration-progress-alt" />
                        <Label fx:id="scholarshipProgressDetailLabel" styleClass="question-side-caption" text="0% de match interno" />
                     </children>
                     <padding>
                        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                     </padding>
                  </VBox>
               </children>
            </VBox>
         </children>
      </HBox>
      <VBox spacing="12.0" styleClass="celebration-footer">
         <children>
            <Label fx:id="encouragementLabel" styleClass="celebration-note" text="Mensagem motivadora final." wrapText="true" />
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <JFXButton fx:id="actionButton" onAction="#Continuar" prefHeight="44.0" prefWidth="190.0" styleClass="btn-primary" text="Ver meu resultado" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
   </padding>
   <styleClass>
      <String fx:value="card" />
      <String fx:value="card-blur" />
      <String fx:value="celebration-modal" />
   </styleClass>
</VBox>
