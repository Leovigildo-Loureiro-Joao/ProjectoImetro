<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="modal" maxHeight="300.0" maxWidth="520.0" minHeight="300.0" minWidth="520.0" prefHeight="300.0" prefWidth="520.0" spacing="14.0" stylesheets="@../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.modals.PausaModalController">
   <children>
      <Label fx:id="tituloLabel" styleClass="h2-thin" text="Pausa da sessao" />
      <Label fx:id="mensagemLabel" styleClass="h3-thin-big" text="O tempo ficou congelado." wrapText="true" />
      <Label fx:id="detalheLabel" styleClass="muted" text="A pausa so pode ser usada uma vez nesta sessao." wrapText="true" />
      <Region VBox.vgrow="ALWAYS" />
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <JFXButton fx:id="continuarButton" onAction="#Continuar" prefHeight="38.0" prefWidth="120.0" styleClass="btn-primary" text="Continuar" />
            <JFXButton fx:id="desistirButton" onAction="#Desistir" prefHeight="38.0" prefWidth="120.0" styleClass="btn-secondary-warm" text="Desistir" />
            <JFXButton fx:id="recomecarButton" onAction="#Recomecar" prefHeight="38.0" prefWidth="120.0" styleClass="btn-secondary" text="Recomeçar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
   </padding>
   <styleClass>
      <String fx:value="card" />
      <String fx:value="card-blur" />
   </styleClass>
</VBox>
