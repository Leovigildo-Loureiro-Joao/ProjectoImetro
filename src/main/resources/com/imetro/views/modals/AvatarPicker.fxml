<?xml version="1.0" encoding="UTF-8"?>

<?import com.jfoenix.controls.JFXButton?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<VBox fx:id="modal" maxHeight="623.0" maxWidth="680.0" minHeight="520.0" minWidth="680.0" prefHeight="623.0" prefWidth="680.0" spacing="18.0" stylesheets="@../../../../styles/candidato-layout.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.imetro.ui.modals.AvatarPickerModalController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="12.0">
         <children>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="h2-thin" text="Trocar avatar" />
                  <Label styleClass="muted" text="Escolhe um avatar pronto para o teu perfil. Nesta versao ainda nao ha upload de imagem." wrapText="true" />
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <JFXButton buttonType="RAISED" contentDisplay="GRAPHIC_ONLY" onAction="#Close" prefHeight="35.0" prefWidth="32.0" translateY="-8.0">
               <graphic>
                  <ImageView fitHeight="17.0" fitWidth="15.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../../assets/imgs/delete_50px.png" />
                     </image>
                  </ImageView>
               </graphic>
            </JFXButton>
         </children>
      </HBox>
      <HBox spacing="24.0">
         <children>
            <VBox alignment="CENTER" prefWidth="210.0" spacing="12.0" styleClass="report-note-card">
               <children>
                  <StackPane prefHeight="148.0" prefWidth="148.0" styleClass="avatar-picker-preview-shell">
                     <children>
                        <ImageView fx:id="avatarPreview" fitHeight="132.0" fitWidth="132.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false">
                           <clip>
                              <Circle centerX="66.0" centerY="66.0" radius="66.0" />
                           </clip>
                        </ImageView>
                        <Label fx:id="avatarInitialsLabel" styleClass="avatar-initials avatar-initials-large" text="AA" />
                     </children>
                  </StackPane>
                  <Label styleClass="h3-thin-big" text="Preview atual" />
                  <Label fx:id="statusLabel" styleClass="muted" text="Escolhe um dos avatares prontos ou mantem as iniciais." wrapText="true">
                     <padding>
                        <Insets left="16.0" right="16.0" />
                     </padding>
                  </Label>
               </children>
               <padding>
                  <Insets bottom="18.0" left="18.0" right="18.0" top="18.0" />
               </padding>
            </VBox>
            <VBox spacing="16.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="h3-thin-big" text="Avatares disponiveis" />
                  <FlowPane fx:id="avatarOptionsBox" hgap="12.0" prefWrapLength="340.0" vgap="12.0" />
                  <HBox alignment="CENTER_RIGHT" spacing="10.0">
                     <children>
                        <JFXButton onAction="#onUseInitials" prefHeight="38.0" prefWidth="145.0" styleClass="btn-secondary" text="Usar iniciais" />
                        <JFXButton onAction="#onConfirmSelection" prefHeight="38.0" prefWidth="170.0" styleClass="btn-primary" text="Confirmar avatar" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets top="8.0" />
               </padding>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
   </padding>
   <styleClass>
      <String fx:value="card" />
      <String fx:value="card-blur" />
   </styleClass>
</VBox>
